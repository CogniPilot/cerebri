include "synapse_topics.fbs";
include "synapse_mocap.fbs";

namespace synapse.sil;

table SimInput {
  gyro:synapse.topic.Vec3f;
  accel:synapse.topic.Vec3f;
  rc:synapse.topic.RcChannels16;
  rc_link_quality:ubyte;
  rc_valid:bool;
  imu_valid:bool;
  // Simulated motion-capture pose, same type the flight path consumes.
  // Appended last so existing field offsets are unchanged.
  mocap:synapse.topic.MocapRigidBodySample;
}

root_type SimInput;
file_identifier "SYSI";
